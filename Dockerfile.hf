# INT-05 NFR-SUS-03: One production image for Render (also works locally).
# Serves FastAPI + /module + /demo + /savanna. Seed on start. No ASR/torch.
# Listens on 0.0.0.0:$PORT (Render sets PORT).
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# api/requirements.txt only — never requirements-asr.txt (keeps image < 1 GB).
COPY api/requirements.txt /app/api/requirements.txt
RUN pip install --no-cache-dir -r /app/api/requirements.txt

COPY api /app/api
COPY demo /app/demo
COPY module /app/module
COPY savanna /app/savanna
COPY tools/vtt_align.py /app/tools/vtt_align.py
COPY tools/sign_motion.py tools/cut_by_pause.py tools/sign_trim_config.json /app/tools/

RUN mkdir -p /data
ENV DATA_DIR=/data
ENV PYTHONPATH=/app
ENV PORT=8000

EXPOSE 8000

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
