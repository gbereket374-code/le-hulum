{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://le-hulum.local/schemas/sign.schema.json",
  "title": "sign.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["lesson", "mode", "segments"],
  "properties": {
    "lesson": { "type": "string" },
    "mode": { "enum": ["continuous", "cues"] },
    "src": { "type": "string" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue", "start", "end", "clip", "source", "confidence"],
        "properties": {
          "cue": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "clip": { "type": "string" },
          "source": { "enum": ["memory", "auto", "human"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
